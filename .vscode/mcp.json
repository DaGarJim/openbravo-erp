{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:github_mcp_pat}"
      }
    },
    "postgres": {
      "type": "sse",
      "url": "http://localhost:8000/sse"
    },
    "postgres-stdio": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network", "openbravo-erp_openbravo-net",
        "-e", "DATABASE_URI=postgresql://tad:tad@postgres:5432/openbravo",
        "crystaldba/postgres-mcp:latest",
        "--access-mode=unrestricted"
      ]
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "github_mcp_pat",
      "description": "GitHub Personal Access Token",
      "password": true
    },
    {
      "id": "db-username",
      "type": "promptString", 
      "description": "PostgreSQL Username",
      "default": "tad"
    },
    {
      "id": "db-password",
      "type": "promptString",
      "description": "PostgreSQL Password",
      "password": true,
      "default": "tad"
    }
  ]
}